/* All primitive literals and optional noise words. */
set the age to 20.
set price = 19.99.
set grade = 'A'.
set newline = '\n'.
set isPassed = true.
set name = "Samantha".
set numbers = [1, 2, 3].
set numbers[0] to 4.
set message = "She said \"hello\".".
show the name.
ask of answer "Continue? ".
if isPassed && age >= 18 then:
    show "Passed".
elif not isPassed:
    show "Try again".
else:
    show "Pending".
set result = (2 + 3) * 4 ^ 2 // 2 % 7.
set same = age is not 10 or false.
set both = true and !false || age != 0.
age++.
age--.
age += 1.
age -= 1.
age *= 2.
age /= 2.
age %= 5.
age ^= 2.
