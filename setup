#!/bin/sh
set -eu

if [ "$#" -gt 1 ] || [ "${1:-}" = '--help' ]; then
    printf 'Usage: sh ./setup [profile-path]\nInstall build and lex shortcuts for Bash or Zsh.\n'
    exit 0
fi

project_dir=$(CDPATH= cd -P "$(dirname "$0")" && pwd)
if [ ! -f "$project_dir/build" ] || [ ! -f "$project_dir/lex" ]; then
    printf 'Missing project scripts: keep setup in the project folder.\n' >&2
    exit 1
fi

if [ "$#" -eq 1 ]; then
    profile_file=$1
else
    shell_name=${SHELL:-}
    case "${shell_name##*/}" in
        zsh) profile_file="${ZDOTDIR:-$HOME}/.zshrc" ;;
        bash)
            case "$(uname -s)" in
                Darwin) profile_file="$HOME/.bash_profile" ;;
                *) profile_file="$HOME/.bashrc" ;;
            esac ;;
        *)
            printf 'Use Bash or Zsh, or supply the profile path: sh ./setup PROFILE\n' >&2
            exit 1 ;;
    esac
fi

mkdir -p "$(dirname "$profile_file")"
temporary_file=$(mktemp "${TMPDIR:-/tmp}/clarifix-setup.XXXXXX")
trap 'rm -f "$temporary_file"' 0
trap 'exit 1' HUP INT TERM

if [ -f "$profile_file" ]; then
    awk '
        $0 == "# BEGIN ClariFix shortcuts" { inside = 1; next }
        $0 == "# END ClariFix shortcuts" { inside = 0; next }
        !inside { print }
        END { if (inside) exit 1 }
    ' "$profile_file" > "$temporary_file"
fi

# Escape paths for double-quoted shell strings, including spaces and dollar signs.
quoted_project=$(printf '%s' "$project_dir" | sed 's/[\\$`"]/\\&/g')
{
    printf '%s\n' '# BEGIN ClariFix shortcuts'
    printf 'build() { sh "%s/build" "$@"; }\n' "$quoted_project"
    printf 'lex() { sh "%s/lex" "$@"; }\n' "$quoted_project"
    printf '%s\n' '# END ClariFix shortcuts'
} >> "$temporary_file"
cat "$temporary_file" > "$profile_file"

printf 'Shortcuts saved to %s\n' "$profile_file"
printf 'Open a new terminal, then run: build\nThen: lex sample\n'
printf 'Run setup again if you move the project folder.\n'
